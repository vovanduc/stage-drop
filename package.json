{
  "name": "stage-drop",
  "version": "0.1.0",
  "description": "Portable instant static-site staging: drag-and-drop → temporary live URL → claim. Local Node + Cloudflare Workers (lab) adapters.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "static-site",
    "staging",
    "hono",
    "local-first"
  ],
  "author": "Duc Vo",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.145.0"
  }
}
