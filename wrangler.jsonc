{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  // Assets: public/ UI. Worker runs first (API/claim/sites); static served via ASSETS binding
  // under /stage-drop/ by rewriting paths in src/worker.ts (ASSETS root is public/).
  // html_handling "none": worker already maps `/` → `/index.html`; avoids ASSETS 308
  // `/index.html` → Location `/` which would escape the /stage-drop/ mount in the browser.
  // Safe with run_worker_first: true (Worker owns all routing). See Cloudflare HTML handling docs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "stage-drop-blobs"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "META",
      // stage-drop-kv-namespace (account dashboard)
      "id": "057096fc08454841a23fbef8243a9344"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
